# Recipe generation mode: ai | mock
VITE_RECIPE_PROVIDER=ai

# Backend API URL (local development)
# Must match the port uvicorn listens on — default backend port is 8010 (backend/run.ps1).
VITE_API_BASE_URL=http://127.0.0.1:8010

# Supabase (community recipes + auth)
# Project URL → VITE_SUPABASE_URL
# Publishable (anon) key → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
