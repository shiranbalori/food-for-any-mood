# Server (local dev — Render sets PORT automatically in production)
PORT=8010
HOST=0.0.0.0

# Comma-separated extra origins (add your Vercel URL after deploy)
# Example: https://food-for-any-mood.vercel.app
CORS_ORIGINS=

# Matches Vercel preview/production domains (default)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# MVP public launch: allow any origin (restrict before scaling)
# CORS_ALLOW_ALL=true

# ---------------------------------------------------------------------------
# Gemini AI (server-side only — never expose in the React frontend)
# ---------------------------------------------------------------------------
# Local: copy to backend/.env
# Render: set in the service Environment tab
GEMINI_API_KEY=your_api_key_here

# Optional model override (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
